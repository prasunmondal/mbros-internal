{
  "id": "./app/",
  "name": "Mondal Brothers Internal",
  "short_name": "MBros",
  "description": "Mondal Brothers internal tools: statements, deliveries, dashboards and reports.",
  "start_url": "./app/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#1f6f4a",
  "icons": [
    { "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Business Dashboard", "url": "./app/profits/", "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "MBros Statement", "url": "./app/mbros-statement/", "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Customer Statement", "url": "./app/statement/", "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Day Summary", "url": "./app/daily/", "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }] }
  ]
}
